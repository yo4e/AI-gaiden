---
import type { CollectionEntry } from 'astro:content';
import { formatJapaneseDate, formatJapaneseDateTime } from '../lib/site';

interface Props {
  data: CollectionEntry<'articles'>['data'];
}

interface PublicCorrection {
  date: string;
  description: string;
}

const { data } = Astro.props;
const titleFallback =
  data.titleFallbackApplied === true ||
  (data.titleTranslationStatus !== undefined && data.titleTranslationStatus !== 'translated');
const summaryFallback =
  data.summaryFallbackApplied === true ||
  data.summaryTranslationStatus === 'quality_rejected' ||
  data.summaryTranslationStatus === 'translation_failed' ||
  data.summaryTranslationStatus === 'source_missing' ||
  (!data.summaryTranslationStatus && data.translationStatus === 'partial');

function stringProperty(record: Record<string, unknown>, keys: string[]): string | undefined {
  for (const key of keys) {
    const value = record[key];
    if (typeof value === 'string' && value.trim()) return value.trim();
  }
  return undefined;
}

function publicCorrection(value: unknown): PublicCorrection | null {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
  const record = value as Record<string, unknown>;
  const date = stringProperty(record, ['date', 'correctedAt', 'updatedAt']);
  const description = stringProperty(record, ['description', 'summary']);
  const validDate = date && !Number.isNaN(new Date(date).getTime());
  return validDate && description ? { date, description } : null;
}

function correctionDate(value: string): string {
  return /^\d{4}-\d{2}-\d{2}$/.test(value)
    ? formatJapaneseDate(value)
    : `${formatJapaneseDateTime(value)} JST`;
}

const corrections = data.correctionHistory
  .map(publicCorrection)
  .filter((correction): correction is PublicCorrection => correction !== null);
---

<section class="article-bulletin" aria-labelledby="article-bulletin-heading">
  <h2 id="article-bulletin-heading">外電票</h2>
  <dl class="article-facts">
    <div>
      <dt>配信元</dt>
      <dd><a href={`/sources/#${data.sourceId}`}>{data.sourceName}</a></dd>
    </div>
    <div><dt>原文タイトル</dt><dd lang="en">{data.titleOriginal}</dd></div>
    {
      data.author && (
        <div>
          <>
            <dt>原文著者</dt>
            <dd>{data.author}</dd>
          </>
        </div>
      )
    }
    <div>
      <dt>原文公開日時</dt>
      <dd>
        <time datetime={data.publishedAt}>{formatJapaneseDateTime(data.publishedAt)} JST</time>
      </dd>
    </div>
    <div>
      <dt>AI外電取得日時</dt>
      <dd><time datetime={data.fetchedAt}>{formatJapaneseDateTime(data.fetchedAt)} JST</time></dd>
    </div>
    <div>
      <dt>AI外電初回生成日時</dt>
      <dd>
        <time datetime={data.generatedAt}>{formatJapaneseDateTime(data.generatedAt)} JST</time>
      </dd>
    </div>
    <div>
      <dt>最終更新日時</dt>
      <dd><time datetime={data.updatedAt}>{formatJapaneseDateTime(data.updatedAt)} JST</time></dd>
    </div>
    <div>
      <dt>タイトル翻訳</dt>
      <dd>{titleFallback ? '原題表示（フォールバック）' : '日本語訳あり'}</dd>
    </div>
    <div>
      <dt>概要翻訳</dt>
      <dd>{summaryFallback ? '公式リンク案内（フォールバック）' : '日本語概要あり'}</dd>
    </div>
    <div>
      <dt>フォールバック</dt>
      <dd>{titleFallback || summaryFallback ? 'あり' : 'なし'}</dd>
    </div>
    <div>
      <dt>人間修正</dt>
      <dd>{data.humanEdited ? 'あり' : 'なし'}</dd>
    </div>
    <div>
      <dt>公式発表</dt>
      <dd>
        <a href={data.sourceUrl} rel="noopener noreferrer">原文を確認する</a>
      </dd>
    </div>
  </dl>

  {
    corrections.length > 0 && (
      <section class="correction-history" aria-labelledby="correction-history-heading">
        <h3 id="correction-history-heading">訂正・更新履歴</h3>
        <ol>
          {corrections.map((correction) => (
            <li>
              <time datetime={correction.date}>{correctionDate(correction.date)}</time>
              <span>{correction.description}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</section>
