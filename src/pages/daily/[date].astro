---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import NewsCard from '../../components/NewsCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatJapaneseDate, formatJapaneseDateTime } from '../../lib/site';

interface Props {
  entry: CollectionEntry<'daily'>;
  previous?: CollectionEntry<'daily'>;
  next?: CollectionEntry<'daily'>;
}

export async function getStaticPaths() {
  const entries = (await getCollection('daily')).sort((a, b) =>
    a.data.date.localeCompare(b.data.date),
  );
  return entries.map((entry, index) => ({
    params: { date: entry.data.date },
    props: {
      entry,
      previous: entries[index - 1],
      next: entries[index + 1],
    },
  }));
}

const { entry, previous, next } = Astro.props;
const canonicalPath = `/daily/${entry.data.date}/`;
const pageUrl = new URL(canonicalPath, Astro.site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    datePublished: entry.data.publishedAt,
    dateModified: entry.data.updatedAt,
    inLanguage: 'ja',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: entry.data.itemCount,
      itemListElement: entry.data.items.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Thing',
          name: item.titleJa,
          url: item.url,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: '過去記事',
        item: new URL('/archive/', Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: entry.data.date, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  image={entry.data.items.find((item) => item.imageUrl)?.imageUrl || '/default-news-image.svg'}
  noindex={entry.data.noindex}
  type="article"
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  structuredData={structuredData}
>
  <header class="page-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくず">
        <ol>
          <li><a href="/">トップ</a></li><li><a href="/archive/">過去記事</a></li><li>
            {entry.data.date}
          </li>
        </ol>
      </nav>
      <p class="eyebrow">Daily digest / {entry.data.itemCount} stories</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p>
        <time datetime={entry.data.date}>{formatJapaneseDate(entry.data.date)}</time>・最終更新 <time
          datetime={entry.data.updatedAt}>{formatJapaneseDateTime(entry.data.updatedAt)} JST</time
        >
      </p>
    </div>
  </header>
  <div class="container section">
    <p class="daily-note">
      このページは公式RSSの内容を自動翻訳・定型編集しています。正確な仕様や表現は、各項目の公式発表でご確認ください。
    </p>
    <div class="news-list">
      {entry.data.items.map((item) => <NewsCard item={item} />)}
    </div>
    {
      (previous || next) && (
        <nav class="date-navigation" aria-label="前後の日次ダイジェスト">
          {previous ? (
            <a href={`/daily/${previous.data.date}/`}>← {previous.data.date}</a>
          ) : (
            <span />
          )}
          {next ? <a href={`/daily/${next.data.date}/`}>{next.data.date} →</a> : <span />}
        </nav>
      )
    }
  </div>
</BaseLayout>
