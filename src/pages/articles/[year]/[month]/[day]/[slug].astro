---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ArticleBulletin from '../../../../../components/ArticleBulletin.astro';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { articlePath, sortArticles } from '../../../../../lib/articles';
import {
  OPERATOR_NAME,
  formatJapaneseDate,
  formatJapaneseDateTime,
} from '../../../../../lib/site';

interface Props {
  article: CollectionEntry<'articles'>;
  previous?: CollectionEntry<'articles'>;
  next?: CollectionEntry<'articles'>;
}

export async function getStaticPaths() {
  const articles = sortArticles(await getCollection('articles'));
  return articles.map((article, index) => {
    const [year, month, day] = article.data.dateJst.split('-');
    return {
      params: { year, month, day, slug: article.data.articleId },
      props: {
        article,
        previous: articles[index - 1],
        next: articles[index + 1],
      },
    };
  });
}

const { article, previous, next } = Astro.props;
const data = article.data;
const canonicalPath = articlePath(data);
const pageUrl = new URL(canonicalPath, Astro.site).href;
const articleImage = data.imageUrl || '/default-news-image.svg';
const articleImageUrl = new URL(articleImage, Astro.site).href;
const articleImageClass = data.imageUrl
  ? 'article-hero__image article-hero__image--source'
  : 'article-hero__image article-hero__image--default';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: data.titleJa,
    description: data.excerptJa,
    url: pageUrl,
    datePublished: data.publishedAt,
    dateModified: data.updatedAt,
    inLanguage: 'ja',
    image: [articleImageUrl],
    isPartOf: { '@type': 'WebSite', name: 'AI外電', url: new URL('/', Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: formatJapaneseDate(data.dateJst),
        item: new URL(`/daily/${data.dateJst}/`, Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: data.titleJa, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={`${data.titleJa}｜${data.sourceName}｜AI外電`}
  description={data.excerptJa}
  canonicalPath={canonicalPath}
  image={articleImage}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  noindex={data.noindex}
  structuredData={structuredData}
>
  <div class="container narrow article-detail">
    <nav class="breadcrumbs" aria-label="パンくず">
      <ol>
        <li><a href="/">トップ</a></li>
        <li><a href={`/daily/${data.dateJst}/`}>{data.dateJst}</a></li>
        <li>{data.titleJa}</li>
      </ol>
    </nav>

    <div class="news-card__meta">
      <a href={`/sources/${data.sourceId}/`} class="source-badge">{data.sourceName}</a>
      <time datetime={data.publishedAt}>{formatJapaneseDateTime(data.publishedAt)} JST</time>
    </div>

    <h1>{data.titleJa}</h1>
    <p class="original-title" lang="en"><em>{data.titleOriginal}</em></p>

    <figure class="article-hero">
      <img
        class={articleImageClass}
        src={articleImage}
        alt={data.imageUrl ? `${data.sourceName}: ${data.titleOriginal}` : `${OPERATOR_NAME}のAI外電既定画像`}
        loading="eager"
        decoding="async"
        referrerpolicy="no-referrer"
      />
      <figcaption>
        {
          data.imageUrl ? (
            <>
              画像: {data.sourceName}公式RSS
              {data.imageLicense && `（${data.imageLicense}）`}
            </>
          ) : (
            <>画像: {OPERATOR_NAME} 既定画像</>
          )
        }
      </figcaption>
    </figure>

    <h2>日本語短報</h2>
    <p class="article-brief">{data.briefJa}</p>

    <ArticleBulletin data={data} />

    <p class="daily-note">
      この記事は公式RSSから自動収集し、ローカル翻訳モデルと定型編集で生成しています。翻訳や取得内容の正確性は保証されないため、重要な確認は公式発表を優先してください。
    </p>

    <div class="article-official">
      <p class="article-official-label">公式原文</p>
      <a class="article-official-link" href={data.sourceUrl} rel="noopener noreferrer">
        ↗ {data.titleOriginal}
      </a>
    </div>

    <nav class="article-nav" aria-label="前後の記事">
      {previous ? <a href={articlePath(previous.data)}>← 前の記事</a> : <span></span>}
      <a class="center-link" href={`/daily/${data.dateJst}/`}>同日の一覧</a>
      {next ? <a href={articlePath(next.data)}>次の記事 →</a> : <span></span>}
    </nav>
  </div>
</BaseLayout>
