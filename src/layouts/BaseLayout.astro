---
import type { ComponentProps } from 'astro/types';
import SeoHead from '../components/SeoHead.astro';
import '../styles/theme.css';
import '../styles/global.css';
import '../styles/refinement.css';

type SeoProps = ComponentProps<typeof SeoHead>;
interface Props extends SeoProps {}

const props = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="AI外電 トップページ">
          <strong>AI外電</strong>
          <small>海外AI公式発表 日本語ダイジェスト</small>
        </a>
        <nav aria-label="主要メニュー">
          <a href="/#latest-digest">最新記事</a>
          <a href="/archive/">過去記事</a>
          <a href="/sources/">情報源</a>
          <a href="/about/">このサイトについて</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__inner">
          <div class="site-footer__brand">
            <strong>AI外電</strong>
            <p>海外AI公式発表を、日本語で読みやすく。</p>
          </div>
          <nav class="site-footer__nav" aria-label="フッターナビゲーション">
            <a href="/#latest-digest">最新記事</a>
            <a href="/archive/">過去記事</a>
            <a href="/sources/">情報源</a>
            <a href="/about/">このサイトについて</a>
            <a href="/gaiden/">運営主体</a>
            <a href="/editorial-policy/">編集・訂正方針</a>
            <a href="/privacy/">プライバシー</a>
            <a href="/feed.xml">RSS</a>
          </nav>
          <small class="site-footer__legal">
            © {new Date().getFullYear()} AI外電 — 自動収集・自動翻訳による試験運用
          </small>
        </div>
      </div>
    </footer>
  </body>
</html>
