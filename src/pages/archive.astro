---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { groupArticlesByDate, sortArticles } from '../lib/articles';
import { formatJapaneseDate, formatJapaneseMonth } from '../lib/site';

const articles = sortArticles(await getCollection('articles'));
const grouped = groupArticlesByDate(articles);
const months = new Map<string, [string, (typeof articles)[number][]][]>();
for (const [date, dayArticles] of grouped) {
  const month = date.slice(0, 7);
  months.set(month, [...(months.get(month) || []), [date, dayArticles]]);
}
---

<BaseLayout
  title="海外AIニュース一覧・過去記事｜AI外電"
  description="AI外電が公式RSSから自動収集・自動翻訳した海外AIニュースを、記事単位と日付別に一覧できます。"
>
  <header class="page-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくず">
        <ol><li><a href="/">トップ</a></li><li>過去記事</li></ol>
      </nav>
      <p class="eyebrow">Archive</p>
      <h1>海外AIニュース一覧・過去記事</h1>
      <p>公式発表を日本時間の日付ごとにまとめた、日本語ダイジェストのアーカイブです。</p>
    </div>
  </header>
  <div class="container section">
    {
      months.size > 0 ? (
        [...months].map(([month, monthEntries]) => (
          <section class="archive-month">
            <h2>{formatJapaneseMonth(month)}</h2>
            <ul class="archive-list">
              {monthEntries.map(([date, dayArticles]) => (
                <li>
                  <time datetime={date}>{formatJapaneseDate(date)}</time>
                  <div class="archive-list__content">
                    <a href={`/daily/${date}/`}>{dayArticles[0].data.titleJa}</a>
                    <small>
                      {dayArticles.length}件・
                      {[...new Set(dayArticles.map((article) => article.data.sourceName))].join(
                        ' / ',
                      )}
                    </small>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <p class="empty-state">公開済みの記事はまだありません。</p>
      )
    }
  </div>
</BaseLayout>
