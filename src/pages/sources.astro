---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceCard from '../components/SourceCard.astro';
import { sources } from '../data/sources';

const articles = await getCollection('articles');
const articleCounts = new Map<string, number>();
for (const article of articles) {
  const sid = article.data.sourceId;
  articleCounts.set(sid, (articleCounts.get(sid) || 0) + 1);
}
const sourceEntries = sources.map((source) => ({
  source,
  count: articleCounts.get(source.id) || 0,
}));
const publishedSources = sourceEntries.filter(({ source, count }) => source.enabled && count > 0);
const preparingSources = sourceEntries.filter(
  ({ source, count }) => !source.enabled || count === 0,
);
---

<BaseLayout
  title="海外AI公式ニュースの情報源一覧｜AI外電"
  description="AI外電が取得対象とする全配信元の公式RSS/Atomと収集方針を紹介します。"
>
  <header class="page-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくず">
        <ol>
          <li><a href="/">トップ</a></li>
          <li>情報源</li>
        </ol>
      </nav>
      <p class="eyebrow">Official sources</p>
      <h1>情報源一覧</h1>
      <p>
        収集対象は公式RSS/Atomフィードのみです。記事ページのHTMLから情報を補完せず、ローカル翻訳モデルと定型編集で日本語短報を生成します。
      </p>
    </div>
  </header>

  <div class="container section">
    <section class="source-group" aria-labelledby="published-sources-heading">
      <div class="source-group__heading">
        <h2 id="published-sources-heading">掲載中の情報源</h2>
        <p>{publishedSources.length}配信元</p>
      </div>
      <div class="source-grid">
        {publishedSources.map(({ source, count }) => <SourceCard source={source} count={count} />)}
      </div>
    </section>
    {
      preparingSources.length > 0 && (
        <section class="source-group" aria-labelledby="preparing-sources-heading">
          <div class="source-group__heading">
            <h2 id="preparing-sources-heading">準備中・一時停止</h2>
            <p>{preparingSources.length}配信元</p>
          </div>
          <div class="source-grid source-grid--pending">
            {preparingSources.map(({ source, count }) => (
              <SourceCard source={source} count={count} />
            ))}
          </div>
        </section>
      )
    }
    <p class="source-grid__note">
      掲載記事数はAI外電内で公開している記事の累計です。0件は、現時点で公開済み記事がないことを示します。
    </p>
  </div>
</BaseLayout>
