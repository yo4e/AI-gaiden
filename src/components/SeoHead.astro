---
import { DEFAULT_DESCRIPTION, DEFAULT_TITLE, SITE_NAME, isPreviewBuild } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: string;
  updatedAt?: string;
  structuredData?: object | object[];
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  image = '/default-news-image.svg',
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
  structuredData,
} = Astro.props;
const preview = isPreviewBuild();
const canonical = new URL(canonicalPath, Astro.site);
const imageUrl = new URL(image, Astro.site);
const robots = preview || noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large';
const jsonLd = structuredData
  ? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
  : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/feed.xml" />

<meta property="og:locale" content="ja_JP" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
