---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import NewsCard from '../../components/NewsCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  articleDateRange,
  articlePath,
  dailyDisplayTitle,
  dailyDescription,
  dailyTitle,
  groupArticlesByDate,
  sortArticles,
} from '../../lib/articles';
import { defaultNewsImagePath, formatJapaneseDate, formatJapaneseDateTime } from '../../lib/site';

interface Props {
  date: string;
  articles: CollectionEntry<'articles'>[];
  previous?: string;
  next?: string;
}

export async function getStaticPaths() {
  const grouped = groupArticlesByDate(await getCollection('articles'));
  const dates = [...grouped.keys()].sort();
  return dates.map((date, index) => ({
    params: { date },
    props: {
      date,
      articles: sortArticles(grouped.get(date) || []),
      previous: dates[index - 1],
      next: dates[index + 1],
    },
  }));
}

const { date, articles, previous, next } = Astro.props;
const seoTitle = dailyTitle(date, articles);
const displayTitle = dailyDisplayTitle(date, articles.length);
const description = dailyDescription(date, articles);
const canonicalPath = `/daily/${date}/`;
const pageUrl = new URL(canonicalPath, Astro.site).href;
const range = articleDateRange(articles);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: seoTitle,
    description,
    url: pageUrl,
    datePublished: range.publishedAt,
    dateModified: range.updatedAt,
    inLanguage: 'ja',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: articles.length,
      itemListElement: articles.map((article, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Article',
          name: article.data.titleJa,
          url: new URL(articlePath(article.data), Astro.site).href,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: '過去記事',
        item: new URL('/archive/', Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: date, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={seoTitle}
  description={description}
  canonicalPath={canonicalPath}
  image={articles.find((article) => article.data.imageUrl)?.data.imageUrl ||
    defaultNewsImagePath(articles[0]?.data.articleId || date)}
  type="article"
  publishedAt={range.publishedAt}
  updatedAt={range.updatedAt}
  structuredData={structuredData}
>
  <header class="page-header page-header--daily">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくず">
        <ol>
          <li><a href="/">トップ</a></li><li><a href="/archive/">過去記事</a></li><li>
            {formatJapaneseDate(date)}
          </li>
        </ol>
      </nav>
      <p class="eyebrow">Daily digest / {articles.length} stories</p>
      <h1>{displayTitle}</h1>
      <p>{description}</p>
      <p>
        <time datetime={date}>{formatJapaneseDate(date)}</time>・最終更新 <time
          datetime={range.updatedAt}>{formatJapaneseDateTime(range.updatedAt)} JST</time
        >
      </p>
    </div>
  </header>
  <div class="container section">
    <p class="daily-note">
      このページは記事単位の公式RSS情報を日本時間の日付で集約した一覧です。各記事の本文と原文は個別ページ・公式発表でご確認ください。
    </p>
    <div class="news-list">
      {articles.map((article) => <NewsCard article={article} />)}
    </div>
    {
      (previous || next) && (
        <nav class="date-navigation" aria-label="前後の日次ダイジェスト">
          {previous ? (
            <a class="date-navigation__link" href={`/daily/${previous}/`}>
              <small>前のダイジェスト</small>
              <span>← {formatJapaneseDate(previous)}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="date-navigation__link date-navigation__link--next" href={`/daily/${next}/`}>
              <small>次のダイジェスト</small>
              <span>{formatJapaneseDate(next)} →</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
