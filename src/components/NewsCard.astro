---
import SourceBadge from './SourceBadge.astro';
import { articlePath } from '../lib/articles';
import { defaultNewsImagePath, formatJapaneseDateTime } from '../lib/site';

interface Article {
  data: {
    articleId: string;
    dateJst: string;
    titleJa: string;
    titleOriginal: string;
    excerptJa: string;
    sourceUrl: string;
    sourceId: string;
    sourceName: string;
    publishedAt: string;
    updatedAt: string;
    imageUrl?: string | null;
    imageLicense?: string | null;
    author?: string | null;
    translationStatus: 'complete' | 'partial';
    summaryTranslationStatus?:
      'legacy' | 'translated' | 'quality_rejected' | 'translation_failed' | 'source_missing';
    summaryFallbackApplied?: boolean;
  };
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const item = article.data;
const internalPath = articlePath(item);
const imageSource = item.imageUrl || defaultNewsImagePath(item.articleId);
const imageClass = item.imageUrl
  ? 'news-card__image news-card__image--source'
  : 'news-card__image news-card__image--default';
const hasFallback =
  item.summaryFallbackApplied ||
  (item.summaryTranslationStatus && item.summaryTranslationStatus !== 'translated') ||
  (!item.summaryTranslationStatus && item.translationStatus === 'partial');
---

<article class="news-card">
  <figure class="news-card__media">
    <a class="news-card__image-wrap" href={internalPath} tabindex="-1" aria-hidden="true">
      <img
        class={imageClass}
        src={imageSource}
        alt=""
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </a>
    {
      item.imageUrl && (
        <figcaption>
          画像: {item.sourceName}公式RSS
          {item.imageLicense && `（${item.imageLicense}）`}
        </figcaption>
      )
    }
  </figure>
  <div class="news-card__body">
    <div class="news-card__meta">
      <SourceBadge id={item.sourceId} name={item.sourceName} />
      <time datetime={item.publishedAt}>{formatJapaneseDateTime(item.publishedAt)} JST</time>
    </div>
    <a href={internalPath} class="news-card__content-link">
      <h2>{item.titleJa}</h2>
      <p class="original-title" lang="en">{item.titleOriginal}</p>
      {!hasFallback && <p class="news-card__excerpt">{item.excerptJa}</p>}
    </a>
    {
      hasFallback && (
        <p class="news-card__excerpt translation-note">
          概要の翻訳がないため、公式リンクで発表内容をご確認ください。
        </p>
      )
    }
    {item.author && <p class="byline">原文著者: {item.author}</p>}
    <div class="news-card__card-links">
      <a class="internal-cta" href={internalPath}>AI外電の短報を読む →</a>
      <a class="official" href={item.sourceUrl} rel="noopener noreferrer">
        公式発表を原文で確認 ↗
      </a>
    </div>
  </div>
</article>
