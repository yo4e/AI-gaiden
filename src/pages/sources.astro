---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sources } from '../data/sources';

const articles = await getCollection('articles');
const articleCounts = new Map<string, number>();
for (const article of articles) {
  const sid = article.data.sourceId;
  articleCounts.set(sid, (articleCounts.get(sid) || 0) + 1);
}
---

<BaseLayout
  title="海外AI公式ニュースの情報源一覧｜AI外電"
  description="AI外電が取得対象とする全配信元の公式RSS/Atomと収集方針を紹介します。"
>
  <header class="page-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくず">
        <ol>
          <li><a href="/">トップ</a></li>
          <li>情報源</li>
        </ol>
      </nav>
      <p class="eyebrow">Official sources</p>
      <h1>情報源一覧</h1>
      <p>
        収集対象は公式RSS/Atomフィードのみです。記事ページのHTMLから情報を補完することはありません。内容はすべて機械翻訳・AI要約によるものです。
      </p>
    </div>
  </header>

  <div class="container section">
    <div class="source-grid">
      {sources.map((source) => {
        const count = articleCounts.get(source.id) || 0;
        return (
          <article class="source-card" id={source.id}>
            <div class="source-card__header">
              <h2>
                <a href={`/sources/${source.id}/`}>{source.name}</a>
              </h2>
              {count > 0 ? (
                <span class="source-card__count">{count}<small>件</small></span>
              ) : (
                <span class="source-card__count source-card__count--empty">新着なし</span>
              )}
            </div>
            {source.description && (
              <p class="source-card__desc">{source.description}</p>
            )}
            {source.categories && source.categories.length > 0 && (
              <div class="source-card__categories">
                {source.categories.map((cat: string) => (
                  <span class="source-card__category">{cat}</span>
                ))}
              </div>
            )}
            <div class="source-card__links">
              {source.homepage && (
                <a href={source.homepage} rel="noopener noreferrer">公式サイト ↗</a>
              )}
              {source.feedUrl && (
                <a href={source.feedUrl} rel="noopener noreferrer">RSS ↗</a>
              )}
            </div>
          </article>
        );
      })}
    </div>
    <p style="margin-top: 1.25rem; font-size: 0.8rem; color: var(--muted);">
      件数は直近の収集数です。RSSフィードに新着がない場合、収集件数は 0 になります。
    </p>
  </div>
</BaseLayout>
