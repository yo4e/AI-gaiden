---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sources } from '../data/sources';
import { sourceCategoryLabel, sourceImagePolicyLabel } from '../lib/sourcePresentation';

const articles = await getCollection('articles');
const articleCounts = new Map<string, number>();
for (const article of articles) {
  articleCounts.set(article.data.sourceId, (articleCounts.get(article.data.sourceId) || 0) + 1);
}
---

<BaseLayout
  title="海外AI公式ニュースの情報源一覧｜AI外電"
  description="AI外電が取得対象とする全配信元の公式RSS/Atomと、RSS限定の収集方針を紹介します。"
>
  <header class="page-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="パンくず">
        <ol><li><a href="/">トップ</a></li><li>情報源</li></ol>
      </nav>
      <p class="eyebrow">Official sources</p>
      <h1>海外AI公式ニュースの情報源一覧</h1>
      <p>
        以下の公式RSS/Atomのみを取得します。記事ページのHTMLから情報や画像を補完することはありません。
      </p>
    </div>
  </header>
  <div class="container section">
    <div class="source-grid">
      {
        sources.map((source) => (
          <article class="source-card" id={source.id}>
            <h2>
              <a href={`/sources/${source.id}/`}>{source.name}</a>
            </h2>
            <p>{source.description}</p>
            <dl>
              <dt>設定状態</dt>
              <dd class={source.enabled ? 'status-active' : ''}>
                {source.enabled ? '取得対象' : '一時停止'}
              </dd>
              <dt>公式サイト</dt>
              <dd>
                <a href={source.homepage} rel="noopener noreferrer">
                  {source.homepage}
                </a>
              </dd>
              <dt>公式RSS</dt>
              <dd>
                <a href={source.feedUrl} rel="noopener noreferrer">
                  {source.feedUrl}
                </a>
              </dd>
              <dt>画像方針</dt>
              <dd>{sourceImagePolicyLabel(source.imagePolicy)}</dd>
              <dt>カテゴリ</dt>
              <dd>{source.categories.map(sourceCategoryLabel).join('、')}</dd>
              <dt>掲載記事数</dt>
              <dd>{articleCounts.get(source.id) || 0}件</dd>
            </dl>
            <p>
              <a class="official-link" href={`/sources/${source.id}/`}>
                配信元ページを見る
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
