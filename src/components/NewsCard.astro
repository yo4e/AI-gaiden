---
import SourceBadge from './SourceBadge.astro';
import { articlePath } from '../lib/articles';
import { formatJapaneseDateTime } from '../lib/site';

interface Article {
  data: {
    articleId: string;
    dateJst: string;
    titleJa: string;
    titleOriginal: string;
    excerptJa: string;
    sourceUrl: string;
    sourceId: string;
    sourceName: string;
    publishedAt: string;
    imageUrl?: string | null;
    imageLicense?: string | null;
    author?: string | null;
    translationStatus: 'complete' | 'partial';
  };
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const item = article.data;
const internalPath = articlePath(item);
---

<article class="news-card">
  <div class="news-card__image-wrap">
    <img
      class="news-card__image"
      src={item.imageUrl || '/default-news-image.svg'}
      alt={item.imageUrl ? `${item.titleJa}のRSS配信画像` : ''}
      width="640"
      height="360"
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
    />
    <small>
      画像: {item.imageUrl ? `${item.sourceName}公式RSS` : 'AI外電 既定画像'}
      {item.imageLicense && `（${item.imageLicense}）`}
    </small>
  </div>
  <div class="news-card__body">
    <div class="news-card__meta">
      <SourceBadge id={item.sourceId} name={item.sourceName} />
      <time datetime={item.publishedAt}>{formatJapaneseDateTime(item.publishedAt)} JST</time>
    </div>
    <h2><a href={internalPath}>{item.titleJa}</a></h2>
    <p class="original-title">
      <span>原文タイトル:</span>
      <span lang="en">{item.titleOriginal}</span>
    </p>
    <p>{item.excerptJa}</p>
    {item.author && <p class="byline">著者: {item.author}</p>}
    {
      item.translationStatus === 'partial' && (
        <p class="translation-note">概要の翻訳がないため、公式リンクで発表内容をご確認ください。</p>
      )
    }
    <p class="card-links">
      <a class="official-link" href={internalPath}>AI外電の記事を読む</a>
      <a href={item.sourceUrl} rel="noopener noreferrer">公式発表を原文で確認する</a>
    </p>
  </div>
</article>
